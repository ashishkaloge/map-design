    "build:fonts": "node tools/build-fonts.mjs",
    "gallery": "node tools/build-gallery.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashishkaloge/map-design.git"
  },
  "devDependencies": {
    "@fontsource/eb-garamond": "5.2.7",
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@fontsource/jost": "5.2.8",
    "@fontsource/libre-franklin": "5.2.8",
    "@fontsource/source-serif-4": "5.2.9",
    "@mapbox/vector-tile": "2.0.5",
    "d3-array": "3.2.4",
    "d3-geo": "3.1.1",
    "esbuild": "0.25.10",
    "pbf": "4.0.2",
    "topojson-client": "3.1.0",
